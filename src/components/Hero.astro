---
import '@fontsource-variable/geist';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';

const navLinks = [
  { href: '#why', label: 'Why spacing' },
  { href: '#compare', label: 'Compare' },
  { href: '#play', label: 'Play' },
  { href: '#features', label: 'Features' },
  { href: '#how', label: 'How it works' },
  { href: '#faq', label: 'FAQ' }
];

const footerLinks = [
  { href: '#features', label: 'Features' },
  { href: '#faq', label: 'FAQ' },
  { href: '#top', label: 'Privacy' },
  { href: '#top', label: 'Terms' }
];

const heroHighlights = [
  'Any font, any size',
  'Syncs local text styles',
  'WCAG 1.4.12 spacing check'
];

const tickerItems = [
  {
    label: 'Tracking',
    style:
      'font-size: 26px; font-weight: 650; letter-spacing: -0.03em; color: #5E6456'
  },
  {
    label: 'Leading',
    style: 'font-size: 26px; font-weight: 300; color: #5E6456'
  },
  {
    label: 'BASELINE GRID',
    style:
      "font-family: 'JetBrains Mono', monospace; font-size: 18px; letter-spacing: 0.1em; color: #5E6456"
  },
  {
    label: 'Measure',
    style:
      'font-size: 26px; font-weight: 400; letter-spacing: 0.04em; color: #5E6456'
  },
  {
    label: 'Vertical rhythm',
    style: 'font-size: 26px; font-weight: 500; color: #5E6456'
  },
  {
    label: 'Readability',
    style:
      'font-size: 26px; font-weight: 650; letter-spacing: -0.03em; color: #5E6456'
  },
  {
    label: 'HIERARCHY',
    style:
      "font-family: 'JetBrains Mono', monospace; font-size: 18px; letter-spacing: 0.1em; color: #5E6456"
  }
];

const wcagStats = [
  { value: '1.5×', label: 'Line height', delay: 300 },
  { value: '2×', label: 'Paragraph spacing', delay: 400 },
  { value: '0.12×', label: 'Letter spacing', delay: 500 },
  { value: '0.16×', label: 'Word spacing', delay: 600 }
];

const compareSpecs = [
  { label: 'HEADING', from: '48 / Auto · 0%', to: '48 / 52 · −3%', delay: 0 },
  { label: 'BODY', from: '18 / Auto · 0%', to: '18 / 30 · +0.3%', delay: 100 },
  { label: 'MEASURE', from: '~ 85 ch', to: '~ 68 ch', delay: 200 }
];

const faqs = [
  {
    question: 'Does TypeHarmony work with any font?',
    answer:
      "Yes. It reads each typeface's own proportions — x-height, cap height and width — so variable fonts, custom brand fonts and Google Fonts all get values that suit them.",
    delay: 0
  },
  {
    question: 'Will it change my design without asking?',
    answer:
      'Never. Every adjustment is previewed live on the canvas first, and once applied it becomes a single history step you can undo with ⌘Z.',
    delay: 70
  },
  {
    question: 'Can it update text styles, not just layers?',
    answer:
      'Yes. Harmonize selected layers, local text styles or both — every instance linked to those styles updates across the file.',
    delay: 140
  },
  {
    question: 'How does the accessibility check work?',
    answer:
      'TypeHarmony compares your spacing with WCAG 2.2 criterion 1.4.12 and flags layers that fall short, with a suggested fix next to each one.',
    delay: 210
  },
  {
    question: 'Can I create presets for my brand?',
    answer:
      'Save your own rules for tracking, line-height and grid, then share them with your team so every file speaks in the same typographic voice.',
    delay: 280
  },
  {
    question: 'What about layers with mixed styles?',
    answer:
      'Mixed text is handled range by range, so a bold lead-in, inline links and body copy inside one layer each receive the right values.',
    delay: 350
  }
];

const presets = [
  {
    label: 'Readable',
    style: 'padding: 8px 14px; border-radius: 999px; background: #C8F53C'
  },
  {
    label: 'Editorial',
    style: 'padding: 8px 14px; border-radius: 999px; border: 1px solid #D3D6CA'
  },
  {
    label: 'Compact',
    style: 'padding: 8px 14px; border-radius: 999px; border: 1px solid #D3D6CA'
  },
  {
    label: 'Interface',
    style: 'padding: 8px 14px; border-radius: 999px; border: 1px solid #D3D6CA'
  },
  {
    label: '+ Your brand',
    style:
      'padding: 8px 14px; border-radius: 999px; border: 1px dashed #9CA290; color: #555B4C'
  }
];

const bulkLayers = [
  {
    label: 'Layer',
    style:
      'width: 40%; height: 26px; box-sizing: border-box; padding: 0 10px; border-radius: 999px; background: rgba(10,11,9,0.12); display: flex; align-items: center'
  },
  {
    label: 'Frame',
    style:
      'width: 58%; height: 26px; box-sizing: border-box; padding: 0 10px; border-radius: 999px; background: rgba(10,11,9,0.2); display: flex; align-items: center'
  },
  {
    label: 'Page',
    style:
      'width: 76%; height: 26px; box-sizing: border-box; padding: 0 10px; border-radius: 999px; background: rgba(10,11,9,0.32); display: flex; align-items: center'
  },
  {
    label: 'Whole file',
    style:
      'width: 100%; height: 26px; box-sizing: border-box; padding: 0 10px; border-radius: 999px; background: #0A0B09; color: #C8F53C; display: flex; align-items: center; justify-content: space-between',
    check: true
  }
];

const bandRows = [
  { height: 32, width: '62%', barHeight: 14, background: '#F1F3EA', delay: '' },
  { height: 24, width: '94%', barHeight: 8, background: '#80877A', delay: '.4s' },
  { height: 24, width: '88%', barHeight: 8, background: '#80877A', delay: '.8s' },
  {
    height: 24,
    width: '91%',
    barHeight: 8,
    background: '#80877A',
    delay: '1.2s'
  },
  { height: 24, width: '56%', barHeight: 8, background: '#80877A', delay: '1.6s' }
];

const auditRows = [
  { label: 'Line 1.5×', status: '✓ pass', pass: true, last: false },
  { label: 'Paragraph 2×', status: '✓ pass', pass: true, last: false },
  { label: 'Letter 0.12×', status: '✓ pass', pass: true, last: false },
  { label: 'Word 0.16×', status: '1 fix', pass: false, last: true }
];
---

<div
  id='top'
  style="width: 100%; min-width: 1440px; height: 10300px; background: #0A0B09; color: #F1F3EA; font-family: 'Geist', sans-serif; overflow: clip; --accent: #C8F53C; --a08: rgba(200,245,60,0.08); --a16: rgba(200,245,60,0.16); --a35: rgba(200,245,60,0.4)"
>
  <div
    class='ld-down'
    style='position: sticky; top: 20px; z-index: 50; height: 64px; margin: 20px max(120px, calc((100% - 1200px) / 2)) -84px'
  >
    <div
      class='nav-pill'
      style='height: 64px; box-sizing: border-box; padding: 0 10px 0 20px; display: flex; align-items: center; justify-content: space-between; border-radius: 999px; background: rgba(14,15,12,0.72); border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 20px 40px -24px rgba(0,0,0,0.6)'
    >
      <a
        href='#top'
        style='display: flex; align-items: center; gap: 10px; text-decoration: none; color: #F1F3EA'
      >
        <span
          style="width: 32px; height: 32px; border-radius: 9px; background: #C8F53C; display: flex; align-items: center; justify-content: center; color: #0A0B09; font-family: 'Geist', sans-serif; font-weight: 700; letter-spacing: -0.04em; font-size: 14px"
          >Aa</span
        >
        <span style='font-size: 18px; font-weight: 700; letter-spacing: -0.03em'
          >TypeHarmony</span
        >
      </a>
      <nav
        aria-label='Primary'
        style='display: flex; gap: 32px; align-items: center'
      >
        {
          navLinks.map(link => (
            <a
              href={link.href}
              class='nl'
              style='color: #A2A898; text-decoration: none; font-size: 14px'
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        href='#install'
        class='btn'
        style='display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; box-sizing: border-box; border-radius: 999px; background: #C8F53C; color: #0A0B09; font-size: 14px; font-weight: 600; text-decoration: none'
        >Install plugin<svg
          class='arr'
          width='15'
          height='15'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.4'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
          ><path d='M5 12h14'></path><path d='M13 6l6 6-6 6'></path></svg
        ></a
      >
    </div>
  </div>

  <section
    style='position: relative; height: 1150px; box-sizing: border-box; padding: 180px max(120px, calc((100% - 1200px) / 2)) 0; overflow: hidden; background-image: repeating-linear-gradient(to bottom, transparent 0 39px, rgba(255,255,255,0.025) 39px 40px)'
  >
    <div
      style='display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 64px; align-items: end'
    >
      <div style='display: flex; flex-direction: column'>
        <div
          class='ld'
          style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 5px 14px 5px 5px; border: 1px solid #272B22; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #A2A898; animation-delay: 100ms"
        >
          <span
            style='padding: 3px 9px; border-radius: 999px; background: #C8F53C; color: #0A0B09; font-weight: 500'
            >NEW</span
          >Figma plugin · letter-spacing &amp; line-height
        </div>
        <h1
          style='margin: 28px 0 0; font-size: 136px; line-height: 0.92; letter-spacing: -0.05em; font-weight: 700; color: #F1F3EA'
        >
          <span class='mask'
            ><span class='mask-in' style='animation-delay: 150ms'>Type that</span
            ></span
          >
          <span class='mask'
            ><span class='mask-in' style='animation-delay: 280ms'
              ><span
                class='breathes'
                style='letter-spacing: -0.05em; color: #C8F53C'>breathes.</span
              ></span
            ></span
          >
        </h1>
        <div
          class='ld'
          style='display: flex; gap: 12px; align-items: center; margin-top: 40px; animation-delay: 620ms'
        >
          <a
            href='#install'
            class='btn'
            style='display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 28px; box-sizing: border-box; border-radius: 999px; background: #C8F53C; color: #0A0B09; font-weight: 600; font-size: 17px; text-decoration: none'
            >Install in Figma<svg
              class='arr'
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
              ><path d='M5 12h14'></path><path d='M13 6l6 6-6 6'></path></svg
            ></a
          >
          <a
            href='#play'
            class='btn btn-ghost'
            style='display: inline-flex; align-items: center; height: 56px; padding: 0 28px; box-sizing: border-box; border-radius: 999px; border: 1px solid #33382D; color: #F1F3EA; font-weight: 500; font-size: 17px; text-decoration: none'
            >Try the spacing game</a
          >
        </div>
      </div>
      <div
        style='display: flex; flex-direction: column; gap: 28px; padding-bottom: 8px'
      >
        <p
          class='ld'
          style='margin: 0; font-size: 18px; line-height: 1.6; color: #A2A898; animation-delay: 480ms'
        >
          TypeHarmony tunes letter-spacing and line-height across your Figma files
          in one click — so every headline, paragraph and label is balanced,
          readable and ready to ship.
        </p>
        <div
          class='ld'
          style='display: flex; flex-direction: column; gap: 12px; font-size: 14px; color: #C9CEBF; animation-delay: 760ms; border-top: 1px solid #22261E; padding-top: 20px'
        >
          {
            heroHighlights.map(highlight => (
              <span style='display: flex; align-items: center; gap: 10px'>
                <svg
                  width='16'
                  height='16'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='#C8F53C'
                  stroke-width='2.4'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  aria-hidden='true'
                >
                  <path d='M5 12.5l4.5 4.5L19 7.5' />
                </svg>
                {highlight}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class='ld-card'
      style='margin-top: 64px; height: 400px; display: grid; grid-template-columns: minmax(0, 1fr) 340px; border-radius: 24px; border: 1px solid #272B22; background: #121410; overflow: hidden; box-shadow: 0 60px 120px -60px rgba(200,245,60,0.18)'
    >
      <div
        style='position: relative; box-sizing: border-box; padding: 36px 48px; background-image: radial-gradient(circle, #23271F 1px, transparent 1.4px); background-size: 20px 20px'
      >
        <div
          style="display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #80877A; margin-bottom: 24px"
        >
          <span>Frame · Article / 1440</span><span>100%</span>
        </div>
        <div
          style='width: 520px; display: flex; flex-direction: column; align-items: center; gap: 8px'
        >
          <div
            style='position: relative; width: 520px; box-sizing: border-box; padding: 18px 20px; border: 1px solid #C8F53C'
          >
            <span
              style='position: absolute; top: -5px; left: -5px; width: 8px; height: 8px; background: #F1F3EA; border: 1px solid #C8F53C'
            ></span>
            <span
              style='position: absolute; top: -5px; right: -5px; width: 8px; height: 8px; background: #F1F3EA; border: 1px solid #C8F53C'
            ></span>
            <span
              style='position: absolute; bottom: -5px; left: -5px; width: 8px; height: 8px; background: #F1F3EA; border: 1px solid #C8F53C'
            ></span>
            <span
              style='position: absolute; bottom: -5px; right: -5px; width: 8px; height: 8px; background: #F1F3EA; border: 1px solid #C8F53C'
            ></span>
            <div
              class='hc-h'
              style='margin: 0 0 16px; font-size: 40px; line-height: 46px; letter-spacing: -0.025em; font-weight: 650; color: #F1F3EA'
            >
              The quiet power of well-set type
            </div>
            <div
              class='hc-p'
              style='font-size: 17px; line-height: 28px; color: #C9CEBF'
            >
              Good spacing guides the eye without asking for attention. Every line
              lands where the reader expects it.
            </div>
            <div
              style='position: absolute; left: 100%; top: 34px; display: flex; align-items: center'
            >
              <span style='width: 18px; height: 1px; background: #C8F53C'
              ></span><span
                style="padding: 5px 10px; border-radius: 6px; background: rgba(200,245,60,0.16); color: #C8F53C; font-family: 'JetBrains Mono', monospace; font-size: 12px; display: flex; gap: 8px; white-space: nowrap"
                ><span style='color: #80877A'>tracking</span><span class='sw'
                  ><span class='sw-a'>0%</span><span class='sw-b'>−2.5%</span
                  ></span
                ></span>
            </div>
            <div
              style='position: absolute; left: 100%; top: 142px; display: flex; align-items: center'
            >
              <span style='width: 18px; height: 1px; background: #C8F53C'
              ></span><span
                style="padding: 5px 10px; border-radius: 6px; background: rgba(200,245,60,0.16); color: #C8F53C; font-family: 'JetBrains Mono', monospace; font-size: 12px; display: flex; gap: 8px; white-space: nowrap"
                ><span style='color: #80877A'>leading</span><span class='sw'
                  ><span class='sw-a'>18 px</span><span class='sw-b'>28 px</span
                  ></span
                ></span>
            </div>
          </div>
          <span
            style="padding: 3px 8px; border-radius: 4px; background: #C8F53C; color: #0A0B09; font-family: 'JetBrains Mono', monospace; font-size: 11px"
            >520 × Hug</span
          >
        </div>
        <div
          class='cursor'
          aria-hidden='true'
          style='position: absolute; left: 610px; top: 300px; display: flex; align-items: flex-start; gap: 4px'
        >
          <svg
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='#C8F53C'
            stroke='#0A0B09'
            stroke-width='1.5'
            stroke-linejoin='round'
            ><path d='M4 3l7 17 2.5-7L21 10.5z'></path></svg
          >
          <span
            style='margin-top: 14px; padding: 3px 8px; border-radius: 6px; background: #C8F53C; color: #0A0B09; font-size: 11px; font-weight: 600'
            >You</span
          >
        </div>
      </div>
      <div
        style='box-sizing: border-box; padding: 28px; border-left: 1px solid #22261E; background: #0F110D; display: flex; flex-direction: column; gap: 4px'
      >
        <div
          style='display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px'
        >
          <span
            style='display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700'
            ><span
              style='width: 22px; height: 22px; border-radius: 6px; background: #C8F53C; color: #0A0B09; display: flex; align-items: center; justify-content: center; font-weight: 700; letter-spacing: -0.04em; font-size: 10px'
              >Aa</span
            >TypeHarmony</span
          >
          <span
            style='padding: 3px 10px; border-radius: 999px; border: 1px solid #33382D; font-size: 11px; color: #A2A898'
            >Readable</span
          >
        </div>
        <div
          style='display: flex; justify-content: space-between; height: 40px; align-items: center; font-size: 14px; border-bottom: 1px solid #1A1D17'
        >
          <span style='color: #A2A898'>Letter-spacing</span><span
            class='sw'
            style="font-family: 'JetBrains Mono', monospace; font-size: 13px"
            ><span class='sw-a'>0%</span><span class='sw-b'>−2.5%</span></span>
        </div>
        <div
          style='display: flex; justify-content: space-between; height: 40px; align-items: center; font-size: 14px; border-bottom: 1px solid #1A1D17'
        >
          <span style='color: #A2A898'>Line height</span><span
            class='sw'
            style="font-family: 'JetBrains Mono', monospace; font-size: 13px"
            ><span class='sw-a'>Auto</span><span class='sw-b'>28 px</span></span>
        </div>
        <div
          style='display: flex; justify-content: space-between; height: 40px; align-items: center; font-size: 14px; border-bottom: 1px solid #1A1D17'
        >
          <span style='color: #A2A898'>Baseline grid</span><span
            style="font-family: 'JetBrains Mono', monospace; font-size: 13px"
            >4 pt</span>
        </div>
        <div
          style='display: flex; justify-content: space-between; height: 40px; align-items: center; font-size: 14px'
        >
          <span style='color: #A2A898'>Accessibility</span><span
            class='sw'
            style="font-family: 'JetBrains Mono', monospace; font-size: 13px"
            ><span class='sw-a' style='color: #A2A898'>Review</span><span
              class='sw-b'
              style='display: flex; align-items: center; gap: 6px; color: #C8F53C'
              ><span
                style='width: 6px; height: 6px; border-radius: 50%; background: #C8F53C'
              ></span>Pass</span
            ></span>
        </div>
        <button
          type='button'
          class='hc-btn'
          style="margin-top: auto; height: 46px; border: 0; border-radius: 12px; background: #C8F53C; color: #0A0B09; box-shadow: inset 0 0 0 1px #C8F53C; font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer"
          ><span class='sw' style='justify-items: center'
            ><span class='sw-a'>Harmonize</span><span
              class='sw-b'
              style='display: flex; align-items: center; gap: 8px'
              ><svg
                width='15'
                height='15'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2.6'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'></path></svg
              >Harmonized</span
            ></span
          ></button
        >
      </div>
    </div>

    <div
      class='ticker ld'
      aria-hidden='true'
      style='position: absolute; left: 0; right: 0; bottom: 0; height: 72px; border-top: 1px solid #1E211B; overflow: hidden; animation-delay: 900ms'
    >
      <div
        class='ticker-track'
        style='display: flex; width: max-content; height: 72px; align-items: center; gap: 48px; padding-left: 48px; white-space: nowrap'
      >
        {
          [...tickerItems, ...tickerItems].map(item => (
            <>
              <>
                <span style={item.style}>{item.label}</span>
                <span style='width: 6px; height: 6px; border-radius: 50%; background: #C8F53C' />
              </>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id='why'
    style='height: 2260px; box-sizing: border-box; padding: 140px max(120px, calc((100% - 1200px) / 2)) 0; background: #F3F4EE; color: #0E0F0C'
  >
    <div
      style='display: flex; flex-direction: column; align-items: center; text-align: center'
    >
      <div
        class='rv-t'
        style="display: inline-flex; align-items: center; gap: 10px; padding: 5px 14px 5px 5px; border: 1px solid #D3D6CA; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: #3F4535"
      >
        <span
          style='padding: 3px 9px; border-radius: 999px; background: #0A0B09; color: #C8F53C; font-weight: 500'
          >01</span
        >THE INVISIBLE CRAFT
      </div>
      <h2
        class='rv-t'
        style='--d: 80ms; margin: 28px 0 0; font-size: 64px; line-height: 1.04; letter-spacing: -0.04em; font-weight: 650'
      >
        Readers never notice good spacing.<br /><span
          class='mark'
          style='padding: 0 8px; background-image: linear-gradient(transparent 56%, #C8F53C 56%, #C8F53C 92%, transparent 92%)'
          >They always feel bad spacing.</span>
      </h2>
      <p
        class='rv-t'
        style='--d: 180ms; margin: 28px 0 0; max-width: 640px; font-size: 20px; line-height: 1.6; color: #555B4C'
      >
        Letter-spacing and line-height decide how fast the eye moves, where it
        rests and how easily it finds the next line. Get them wrong, and even a
        beautiful typeface feels cramped, noisy or tiring.
