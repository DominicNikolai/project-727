<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: #0a0b09;
  }
  h1,
  h2,
  h3 {
    font-family: 'Geist', sans-serif;
  }
  a {
    color: #c8f53c;
  }
  a:hover {
    color: #e3ff8f;
  }
  .nav-pill {
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
  }
  .outline-num {
    color: transparent;
    -webkit-text-stroke: 1.5px #0e0f0c;
  }

  .ld {
    animation: thUp 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .ld-down {
    animation: thDown 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .mask-in {
    display: block;
    animation: thMask 1.15s cubic-bezier(0.19, 1, 0.22, 1) both;
  }
  .breathes {
    display: inline-block;
    animation:
      thTrackIn 1.9s cubic-bezier(0.19, 1, 0.22, 1) 0.35s both,
      thBreathe 7s ease-in-out 2.8s infinite;
  }
  .ld-card {
    animation: thCard 1.3s cubic-bezier(0.19, 1, 0.22, 1) 0.5s both;
  }
  .dot-pulse {
    animation: thDot 2.4s ease-out infinite;
  }
  .cursor {
    animation: thCursor 9s ease-in-out 2s infinite;
  }

  .hc-h {
    animation: thHcTrack 8s cubic-bezier(0.65, 0, 0.35, 1) 1.8s infinite backwards;
  }
  .hc-p {
    background-image: linear-gradient(
      to bottom,
      transparent calc(100% - 1px),
      var(--a35) calc(100% - 1px)
    );
    background-size: 100% 28px;
    animation: thHcLead 8s cubic-bezier(0.65, 0, 0.35, 1) 1.8s infinite backwards;
  }
  .sw {
    display: inline-grid;
    justify-items: end;
    align-items: center;
  }
  .sw > span {
    grid-area: 1/1;
  }
  .sw-a {
    opacity: 0;
    animation: thSwA 8s ease 1.8s infinite backwards;
  }
  .sw-b {
    animation: thSwB 8s ease 1.8s infinite backwards;
  }
  .hc-btn {
    animation: thBtn 8s ease 1.8s infinite backwards;
  }

  .ticker {
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }
  .ticker-track {
    animation: thMarquee 50s linear infinite;
  }

  .lead-loop {
    animation: thLead 7s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .track-loop {
    animation: thTrackFix 7s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .scan {
    animation: thScan 5s steps(37, end) infinite;
  }
  .band {
    animation: thBand 3.6s ease-in-out infinite;
  }
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: thPulse 2.4s ease-out infinite;
  }
  .sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -50%;
    width: 40%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 255, 255, 0.5),
      transparent
    );
    animation: thSheen 3.8s ease-in-out infinite;
    pointer-events: none;
  }
  .drift {
    animation: thDrift 14s linear infinite;
  }
  .spin {
    animation: thSpin 6s linear infinite;
    transform-origin: center;
  }
  .key {
    animation: thPress 3.2s ease-in-out infinite;
  }
  .breathe-cta {
    display: inline-block;
    animation: thBreatheCta 6s ease-in-out infinite;
  }

  .btn {
    transition:
      translate 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.3s,
      background-color 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  .btn:hover {
    translate: 0 -2px;
    box-shadow: 0 14px 34px -14px var(--a35);
  }
  .btn .arr {
    transition: translate 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .btn:hover .arr {
    translate: 4px 0;
  }
  .btn-ghost:hover {
    border-color: var(--accent) !important;
  }
  .nl {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    padding-bottom: 4px;
    transition:
      background-size 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      color 0.25s;
  }
  .nl:hover {
    background-size: 100% 1px;
    color: #f1f3ea !important;
  }
  .card:hover {
    translate: 0 -6px;
  }
  .card-l:hover {
    border-color: #bfc4b3 !important;
    box-shadow: 0 28px 56px -32px rgba(14, 15, 12, 0.4) !important;
  }
  .faq .faq-q {
    transition: color 0.25s;
  }
  .faq:hover .faq-q {
    color: #4a6400;
  }
  .acc-ico {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s,
      border-color 0.3s;
  }
  .acc-body {
    transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wordmark {
    transition: color 0.8s ease;
  }
  .wordmark:hover {
    color: #1d2016;
  }
  .gtxt {
    transition:
      letter-spacing 0.15s ease,
      line-height 0.15s ease,
      background-size 0.15s ease;
  }
  .gtxt-auto {
    transition-duration: 1.1s;
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }
  .gfill {
    transition: width 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .win {
    animation: thWin 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  button:disabled {
    cursor: not-allowed;
  }
  .cmp-range {
    -webkit-appearance: none;
    appearance: none;
  }

  .rv,
  .rv-t,
  .rv-s,
  .rv-l,
  .rv-r {
    transition:
      opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
      transform 1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
      translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.45s,
      box-shadow 0.45s;
  }
  .rv-on .rv:not(.in) {
    opacity: 0;
    transform: translateY(40px);
  }
  .rv-on .rv-t:not(.in) {
    opacity: 0;
    transform: translateY(20px);
  }
  .rv-on .rv-s:not(.in) {
    opacity: 0;
    transform: translateY(48px) scale(0.965);
  }
  .rv-on .rv-l:not(.in) {
    opacity: 0;
    transform: translateX(-56px);
  }
  .rv-on .rv-r:not(.in) {
    opacity: 0;
    transform: translateX(56px);
  }
  .rv-line {
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1) var(--d, 0ms);
  }
  .rv-on .rv-line:not(.in) {
    transform: scaleX(0);
  }
  .mark {
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transition: background-size 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.5s;
  }
  .rv-on .rv-t:not(.in) .mark {
    background-size: 0% 100%;
  }
  .rv-chart .draw {
    transition: stroke-dashoffset 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s;
  }
  .rv-on .rv-chart:not(.in) .draw {
    stroke-dashoffset: 1;
  }
  .pop {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0ms);
  }
  .rv-on .rv-chart:not(.in) .pop {
    transform: scale(0);
  }
  .lbl {
    transition: opacity 0.6s ease 1.9s;
  }
  .rv-on .rv-chart:not(.in) .lbl {
    opacity: 0;
  }

  @keyframes thUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes thDown {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes thMask {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @keyframes thTrackIn {
    from {
      letter-spacing: 0.14em;
      opacity: 0;
    }
    to {
      letter-spacing: -0.05em;
      opacity: 1;
    }
  }
  @keyframes thBreathe {
    0%,
    100% {
      letter-spacing: -0.05em;
    }
    50% {
      letter-spacing: -0.02em;
    }
  }
  @keyframes thCard {
    from {
      opacity: 0;
      transform: translateY(48px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes thDot {
    0% {
      box-shadow: 0 0 0 0 var(--a35);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }
  @keyframes thCursor {
    0%,
    100% {
      transform: translate(0, 0);
    }
    30% {
      transform: translate(-60px, -34px);
    }
    55% {
      transform: translate(-20px, -80px);
    }
    80% {
      transform: translate(30px, -20px);
    }
  }
  @keyframes thHcTrack {
    0%,
    20% {
      letter-spacing: 0;
    }
    38%,
    84% {
      letter-spacing: -0.025em;
    }
    100% {
      letter-spacing: 0;
    }
  }
  @keyframes thHcLead {
    0%,
    20% {
      line-height: 18px;
      background-size: 100% 18px;
    }
    38%,
    84% {
      line-height: 28px;
      background-size: 100% 28px;
    }
    100% {
      line-height: 18px;
      background-size: 100% 18px;
    }
  }
  @keyframes thSwA {
    0%,
    22% {
      opacity: 1;
    }
    32%,
    84% {
      opacity: 0;
    }
    94%,
    100% {
      opacity: 1;
    }
  }
  @keyframes thSwB {
    0%,
    22% {
      opacity: 0;
    }
    32%,
    84% {
      opacity: 1;
    }
    94%,
    100% {
      opacity: 0;
    }
  }
  @keyframes thBtn {
    0%,
    22% {
      background-color: transparent;
      color: var(--accent);
    }
    32%,
    84% {
      background-color: var(--accent);
      color: #0a0b09;
    }
    94%,
    100% {
      background-color: transparent;
      color: var(--accent);
    }
  }
  @keyframes thMarquee {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes thLead {
    0%,
    18% {
      line-height: 14px;
    }
    38%,
    82% {
      line-height: 21px;
    }
    100% {
      line-height: 14px;
    }
  }
  @keyframes thTrackFix {
    0%,
    18% {
      letter-spacing: 0.06em;
    }
    38%,
    82% {
      letter-spacing: -0.02em;
    }
    100% {
      letter-spacing: 0.06em;
    }
  }
  @keyframes thScan {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(296px);
    }
  }
  @keyframes thBand {
    0%,
    100% {
      background-color: transparent;
    }
    25%,
    45% {
      background-color: var(--a16);
    }
  }
  @keyframes thPulse {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(3.4);
      opacity: 0;
    }
  }
  @keyframes thSheen {
    0% {
      left: -50%;
    }
    45%,
    100% {
      left: 130%;
    }
  }
  @keyframes thDrift {
    to {
      background-position: 40px 40px;
    }
  }
  @keyframes thSpin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes thPress {
    0%,
    62%,
    100% {
      transform: none;
      box-shadow: 0 6px 0 #000;
    }
    70%,
    80% {
      transform: translateY(5px);
      box-shadow: 0 1px 0 #000;
    }
  }
  @keyframes thBreatheCta {
    0%,
    100% {
      letter-spacing: -0.05em;
    }
    50% {
      letter-spacing: 0.04em;
    }
  }
  @keyframes thWin {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const ACCENT = '#C8F53C';

  const root = document.getElementById('top');

  if (root) {
    root.classList.add('rv-on');

    const revealTargets = root.querySelectorAll(
      '.rv, .rv-t, .rv-s, .rv-l, .rv-r, .rv-line, .rv-chart'
    );

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            revealObserver.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );

      revealTargets.forEach(target => revealObserver.observe(target));
    } else {
      revealTargets.forEach(target => target.classList.add('in'));
    }
  }

  const compareRange = document.getElementById(
    'cmp-range'
  ) as HTMLInputElement | null;
  const compareAfter = document.getElementById('cmp-after');
  const compareHandle = document.getElementById('cmp-handle');

  if (compareRange && compareAfter && compareHandle) {
    const setSplit = (value: number) => {
      compareAfter.style.clipPath = `inset(0 0 0 ${value}%)`;
      compareHandle.style.left = `${value}%`;
    };

    compareRange.addEventListener('input', () =>
      setSplit(Number(compareRange.value))
    );
  }

  const faqItems = Array.from(document.querySelectorAll('.faq-item'));
  let openFaq = 0;

  const setFaq = (openIndex: number) => {
    faqItems.forEach((item, index) => {
      const isOpen = index === openIndex;
      const icon = item.querySelector<HTMLElement>('.acc-ico');
      const body = item.querySelector<HTMLElement>('.acc-body');

      item.querySelector('button')?.setAttribute('aria-expanded', String(isOpen));

      if (body) body.style.gridTemplateRows = isOpen ? '1fr' : '0fr';

      if (icon) {
        icon.style.background = isOpen ? ACCENT : 'transparent';
        icon.style.border = `1px solid ${isOpen ? ACCENT : '#C9CCBF'}`;
        icon.style.color = isOpen ? '#0A0B09' : '#0E0F0C';
        icon.style.transform = isOpen ? 'rotate(45deg)' : 'none';
      }
    });

    openFaq = openIndex;
  };

  faqItems.forEach((item, index) => {
    item.querySelector('button')?.addEventListener('click', () => {
      setFaq(openFaq === index ? -1 : index);
    });
  });

  setFaq(0);

  type Round = {
    kicker: string;
    text: string;
    size: number;
    weight: number;
    transform: string;
    width: number;
    startSpacing: number;
    startLeading: number;
    targetSpacing: number;
    targetLeading: number;
    spacingWeight: number;
    leadingWeight: number;
    hint: string;
  };

  const ROUNDS: Round[] = [
    {
      kicker: 'Round 1 · Display headline · 56 px',
      text: 'Every letter finds its place',
      size: 56,
      weight: 650,
      transform: 'none',
      width: 640,
      startSpacing: 8,
      startLeading: 150,
      targetSpacing: -2.5,
      targetLeading: 110,
      spacingWeight: 6,
      leadingWeight: 0.9,
      hint: 'big type wants tighter tracking and a compact line-height.'
    },
    {
      kicker: 'Round 2 · Body copy · 17 px',
      text: 'Good spacing is felt rather than seen. When letters and lines sit at the right distance, the eye glides from word to word and returns to the next line without effort, so the reader can simply enjoy the story.',
      size: 17,
      weight: 400,
      transform: 'none',
      width: 560,
      startSpacing: -5,
      startLeading: 100,
      targetSpacing: 0,
      targetLeading: 160,
      spacingWeight: 6,
      leadingWeight: 0.9,
      hint: 'long reading needs neutral tracking and generous leading.'
    },
    {
      kicker: 'Round 3 · Label · 18 px caps',
      text: 'New release\nSpacing · Rhythm · Harmony',
      size: 18,
      weight: 600,
      transform: 'uppercase',
      width: 640,
      startSpacing: -4,
      startLeading: 100,
      targetSpacing: 12,
      targetLeading: 150,
      spacingWeight: 6,
      leadingWeight: 0.6,
      hint: 'small capitals need extra air between the letters.'
    }
  ];

  const byId = (id: string) => document.getElementById(id) as HTMLElement;

  const gameText = byId('g-text') as HTMLDivElement;
  const spacingInput = byId('g-ls') as HTMLInputElement;
  const leadingInput = byId('g-lh') as HTMLInputElement;
  const nextButton = byId('g-next') as HTMLButtonElement;
  const scoreEl = byId('g-score') as HTMLSpanElement;
  const fillEl = byId('g-fill') as HTMLDivElement;
  const winEl = byId('g-win') as HTMLSpanElement;
  const kickerEl = byId('g-kicker') as HTMLSpanElement;
  const hintEl = byId('g-hint') as HTMLSpanElement;
  const spacingLabel = byId('g-lsl') as HTMLSpanElement;
  const leadingLabel = byId('g-lhl') as HTMLSpanElement;
  const statusEl = byId('g-status') as HTMLDivElement;
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.g-dot'));

  let round = 0;
  let spacing = 0;
  let leading = 0;

  const scoreStatus = (score: number) => {
    if (score >= 92)
      return 'Beautiful. That is exactly how a typographer would set it.';
    if (score >= 70) return 'Getting close — fine-tune a little more.';
    if (score >= 40) return 'Better, but it still feels off.';
    return 'Something feels wrong. Keep dragging.';
  };

  const render = (animated: boolean) => {
    const current = ROUNDS[round];

    gameText.className = animated ? 'gtxt gtxt-auto' : 'gtxt';
    gameText.style.fontSize = `${current.size}px`;
    gameText.style.fontWeight = String(current.weight);
    gameText.style.textTransform = current.transform;
    gameText.style.maxWidth = `${current.width}px`;
    gameText.style.letterSpacing = `${spacing / 100}em`;
    gameText.style.lineHeight = `${leading}%`;
    gameText.style.backgroundSize = `100% ${(current.size * leading) / 100}px`;
    gameText.textContent = current.text;

    kickerEl.textContent = current.kicker;
    hintEl.textContent = current.hint;

    spacingInput.value = String(spacing);
    leadingInput.value = String(leading);

    spacingLabel.textContent = `${spacing > 0 ? '+' : spacing < 0 ? '−' : ''}${Math.abs(spacing).toFixed(1)}%`;
    leadingLabel.textContent = `${leading}%`;

    const distance =
      Math.abs(spacing - current.targetSpacing) * current.spacingWeight +
      Math.abs(leading - current.targetLeading) * current.leadingWeight;
    const score = Math.max(0, Math.min(100, Math.round(100 - distance)));
    const solved = score >= 92;

    scoreEl.textContent = String(score);
    scoreEl.style.color = solved ? ACCENT : '#F1F3EA';
    fillEl.style.width = `${score}%`;
    statusEl.textContent = scoreStatus(score);
    winEl.hidden = !solved;
    nextButton.disabled = !solved;
    nextButton.textContent =
      round === ROUNDS.length - 1 ? 'Play again' : 'Next round';
    nextButton.style.border = solved ? '0' : '1px solid #22261E';
    nextButton.style.background = solved ? '#F1F3EA' : 'transparent';
    nextButton.style.color = solved ? '#0A0B09' : '#5E6456';
    nextButton.style.cursor = solved ? 'pointer' : 'not-allowed';

    dots.forEach((dot, index) => {
      dot.style.background = index <= round ? '#0E0F0C' : '#D0D3C6';
    });
  };

  const startRound = (index: number) => {
    round = index;
    spacing = ROUNDS[index].startSpacing;
    leading = ROUNDS[index].startLeading;
    render(false);
  };

  spacingInput.addEventListener('input', () => {
    spacing = Number.parseFloat(spacingInput.value);
    render(false);
  });

  leadingInput.addEventListener('input', () => {
    leading = Number.parseFloat(leadingInput.value);
    render(false);
  });

  byId('g-auto').addEventListener('click', () => {
    spacing = ROUNDS[round].targetSpacing;
    leading = ROUNDS[round].targetLeading;
    render(true);
  });

  byId('g-reset').addEventListener('click', () => startRound(round));

  nextButton.addEventListener('click', () => {
    if (nextButton.disabled) return;
    startRound((round + 1) % ROUNDS.length);
  });

  startRound(0);
</script>
